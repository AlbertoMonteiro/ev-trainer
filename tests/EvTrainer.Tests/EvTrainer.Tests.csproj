<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="IfDifferent" />
    <!-- Personal data, git-ignored: only present on the owner's machine (golden tests skip without it). -->
    <None Include="../../user-data-export.json" Link="Fixtures/user-data-export.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../user-data-export.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EvTrainer.Web\EvTrainer.Web.csproj" />
  </ItemGroup>

</Project>