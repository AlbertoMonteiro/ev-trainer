@page "/"
@inherits StoreAwareComponent
@inject ToastService Toasts

<PageTitle>@L["App.Title"]</PageTitle>

<AppHeader OnNavigate="Navigate" OnCapture="() => Open(Page.Capture)" OnSync="() => Open(Page.Sync)" OnGuide="() => Open(Page.Guide)"
           OnLeague="() => Open(Page.League)" OnParty="() => Open(Page.Party)" />

<div class="app-body">
    <PokemonSidebar OnChoose="Choose" OnAdd="AddPokemon" OnParty="() => Open(Page.Party)" />
    <main class="page">
        @switch (_page)
        {
            case Page.League:
                <LeaguePlannerView OnClose="Close" />
                break;
            case Page.Guide:
                <TrainingGuideView OnClose="Close" />
                break;
            case Page.Sync:
                <SyncView OnClose="Close" />
                break;
            case Page.Capture:
                <CaptureView OnClose="Close" OnAdded="() => Navigate(Tab.Ivs)" />
                break;
            case Page.Party:
                <PartyView OnClose="Close" OnOpen="Choose" />
                break;
            case Page.ExpPlan:
                <ExpSharePlanView OnClose="Close" OnParty="() => Open(Page.Party)" InitialTrainerId="@_planTrainer" InitialStage="_planStage" />
                break;
            default:
                @if (Store.Selected is null)
                {
                    <EmptyState OnAdd="AddPokemon" OnCapture="() => Open(Page.Capture)">
                        <BackupPanel ImportOnly />
                    </EmptyState>
                }
                else
                {
                    <Tabs Active="_tab" ActiveChanged="tab => _tab = tab" />
                    <section class="tab-panel" role="tabpanel">
                        @switch (_tab)
                        {
                            case Tab.Evs:
                                <EvTab OnOpenGuide="() => Open(Page.Guide)" OnPlan="OpenPlan" />
                                break;
                            case Tab.Ivs:
                                <IvTab />
                                break;
                            case Tab.Settings:
                                <div class="settings-layout">
                                    <SettingsForm />
                                    <BackupPanel />
                                    <SpreadsheetImportPanel />
                                    <DeletePanel />
                                </div>
                                break;
                        }
                    </section>
                }

                break;
        }
    </main>
</div>

<Toast />

@code {
    /// <summary>What the main area shows: the tabs of the selected Pokémon or one of the full pages.</summary>
    private enum Page
    {
        Tabs,
        League,
        Guide,
        Sync,
        Capture,
        Party,
        ExpPlan,
    }

    private Tab _tab = Tab.Evs;
    private Page _page = Page.Tabs;

    private string? _planTrainer;
    private int? _planStage;

    private void Open(Page page) => _page = page;

    private void OpenPlan((string? TrainerId, int? Stage) start)
    {
        (_planTrainer, _planStage) = start;
        _page = Page.ExpPlan;
    }

    private void Close() => _page = Page.Tabs;

    /// <summary>Picking a Pokémon in the side panel keeps the tab and leaves any page.</summary>
    private void Choose(string id)
    {
        _page = Page.Tabs;
        Store.Select(id);
    }

    private void Navigate(Tab tab)
    {
        _page = Page.Tabs;
        _tab = tab;
    }

    private void AddPokemon()
    {
        _page = Page.Tabs;
        if (!Store.IsInParty(Store.AddPokemon()))
        {
            Toasts.Show(L["Party.FullOnAdd"]);
        }

        _tab = Tab.Settings;
    }
}
