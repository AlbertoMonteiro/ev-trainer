@page "/"
@inherits StoreAwareComponent

<PageTitle>@L["App.Title"]</PageTitle>

<AppHeader OnNavigate="Navigate" OnCapture="OpenCapture" OnSync="OpenSync" OnGuide="OpenGuide" OnLeague="OpenLeague" />

<div class="app-body">
    <PokemonSidebar OnChoose="Choose" OnAdd="AddPokemon" />
    <main class="page">
        @if (_planning)
        {
            <LeaguePlannerView OnClose="() => _planning = false" />
        }
        else if (_guiding)
        {
            <TrainingGuideView OnClose="() => _guiding = false" />
        }
        else if (_syncing)
        {
            <SyncView OnClose="() => _syncing = false" />
        }
        else if (_capturing)
        {
            <CaptureView OnClose="() => _capturing = false" OnAdded="() => Navigate(Tab.Ivs)" />
        }
        else if (Store.Selected is null)
        {
            <EmptyState OnAdd="AddPokemon" OnCapture="OpenCapture">
                <BackupPanel ImportOnly />
            </EmptyState>
        }
        else
        {
            <Tabs Active="_tab" ActiveChanged="tab => _tab = tab" />
            <section class="tab-panel" role="tabpanel">
                @switch (_tab)
                {
                    case Tab.Evs:
                        <EvTab OnOpenGuide="OpenGuide" />
                        break;
                    case Tab.Ivs:
                        <IvTab />
                        break;
                    case Tab.Settings:
                        <div class="settings-layout">
                            <SettingsForm />
                            <BackupPanel />
                            <SpreadsheetImportPanel />
                            <DeletePanel />
                        </div>
                        break;
                }
            </section>
        }
    </main>
</div>

<Toast />

@code {
    private Tab _tab = Tab.Evs;
    private bool _capturing;
    private bool _syncing;
    private bool _guiding;
    private bool _planning;

    private void OpenLeague()
    {
        _capturing = false;
        _syncing = false;
        _guiding = false;
        _planning = true;
    }

    private void OpenGuide()
    {
        _planning = false;
        _capturing = false;
        _syncing = false;
        _guiding = true;
    }

    private void OpenCapture()
    {
        _planning = false;
        _guiding = false;
        _syncing = false;
        _capturing = true;
    }

    private void OpenSync()
    {
        _planning = false;
        _guiding = false;
        _capturing = false;
        _syncing = true;
    }

    /// <summary>Picking a Pokémon in the side panel keeps the tab and leaves the capture screen.</summary>
    private void Choose(string id)
    {
        _planning = false;
        _capturing = false;
        _syncing = false;
        _guiding = false;
        Store.Select(id);
    }

    private void Navigate(Tab tab)
    {
        _planning = false;
        _capturing = false;
        _syncing = false;
        _guiding = false;
        _tab = tab;
    }

    private void AddPokemon()
    {
        _planning = false;
        _capturing = false;
        _syncing = false;
        _guiding = false;
        Store.AddPokemon();
        _tab = Tab.Settings;
    }
}
