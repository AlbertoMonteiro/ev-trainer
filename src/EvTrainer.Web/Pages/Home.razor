@page "/"
@inherits StoreAwareComponent

<PageTitle>@L["App.Title"]</PageTitle>

<AppHeader OnNavigate="Navigate" OnCapture="() => _capturing = true" />

<main class="page">
    @if (_capturing)
    {
        <CaptureView OnClose="() => _capturing = false" OnAdded="() => Navigate(Tab.Ivs)" />
    }
    else if (Store.Selected is null)
    {
        <EmptyState OnAdd="AddPokemon" OnCapture="() => _capturing = true">
            <BackupPanel ImportOnly />
        </EmptyState>
    }
    else
    {
        <Tabs Active="_tab" ActiveChanged="tab => _tab = tab" />
        <section class="tab-panel" role="tabpanel">
            @switch (_tab)
            {
                case Tab.Evs:
                    <EvTab />
                    break;
                case Tab.Ivs:
                    <IvTab />
                    break;
                case Tab.Settings:
                    <SettingsForm />
                    <BackupPanel />
                    <SpreadsheetImportPanel />
                    <DeletePanel />
                    break;
            }
        </section>
    }
</main>

<Toast />

@code {
    private Tab _tab = Tab.Evs;
    private bool _capturing;

    private void Navigate(Tab tab)
    {
        _capturing = false;
        _tab = tab;
    }

    private void AddPokemon()
    {
        Store.AddPokemon();
        _tab = Tab.Settings;
    }
}
