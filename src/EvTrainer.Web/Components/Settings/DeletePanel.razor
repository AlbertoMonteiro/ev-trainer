@inherits StoreAwareComponent
@inject ToastService Toasts

@if (Store.Selected is { } pokemon && Store.SelectedId is { } id)
{
    var label = PokemonLabel(pokemon);
    <details class="card delete-card">
        <summary>@L["Delete.Title"]</summary>
        <p class="hint">@L["Delete.Hint", label]</p>
        <button type="button" class="danger" @onclick="() => Delete(id, label)">@L["Delete.Confirm", label]</button>
    </details>
}

@code {
    private void Delete(string id, string name)
    {
        if (Store.DeletePokemon(id) is { } undo)
        {
            Toasts.Show(L["Toast.PokemonDeleted", name], undo);
        }
    }
}
