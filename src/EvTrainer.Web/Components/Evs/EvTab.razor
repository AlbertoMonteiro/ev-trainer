@inherits StoreAwareComponent
@inject ToastService Toasts
@inject OpponentSearch Search

<div class="ev-layout">
    <div class="ev-summary-area">
        <EvSummary OnPlan="() => OnPlan.InvokeAsync((null, null))" />
        <button type="button" class="link open-guide" @onclick="OnOpenGuide">@L["Guide.Open"]</button>
    </div>

    <OpponentSearchBar Query="@_query" QueryChanged="q => _query = q" Searching="@Searching" Filter="@Store.Preferences.Filter" FilterChanged="Store.SetFilter" />

    @if (Store.Selected is { } pokemon)
    {
        var searching = Searching;
        var recent = searching ? [] : Evs.Recent(pokemon.Events, Store.Data);
        var recentNames = recent.Select(o => o.Name).ToHashSet(StringComparer.Ordinal);
        var useful = Store.Preferences.Filter != "all";

        @if (searching && Search.FindTrainers(_query) is { Count: > 0 } trainers)
        {
            <ol class="trainer-results" aria-label="@L["TrainerCard.Results"]">
                @foreach (var trainer in trainers)
                {
                    <TrainerCard @key="trainer.Id" Trainer="trainer" OnPlan="OnPlan" />
                }
            </ol>
        }

        @if (recent.Count > 0)
        {
            <div class="recent-list">
                <OpponentGrid Title="@L["Evs.List.Recent"]" Items="@([.. recent.Select(o => new SearchHit(o))])" OnPick="Record" />
            </div>
        }

        <div class="main-list">
            @foreach (var group in MainGroups(pokemon, searching, useful, recentNames))
            {
                <OpponentGrid @key="group.Title" Title="@group.Title" Items="@group.Items"
                              EmptyText="@(searching || !useful ? L["Empty.NoResults"] : L["Empty.NoUseful"])"
                              OnPick="Record" />
            }
        </div>

        <RecentHistory />
    }
</div>

@code {
    [Parameter]
    public EventCallback OnOpenGuide { get; set; }

    /// <summary>Opens the Exp. Share plan (spec 016), with a trainer and the index of one of its stages when chosen in a card.</summary>
    [Parameter]
    public EventCallback<(string? TrainerId, int? Stage)> OnPlan { get; set; }

    private string _query = string.Empty;

    private bool Searching => !string.IsNullOrWhiteSpace(_query);

    private sealed record Group(string Title, IReadOnlyList<SearchHit> Items);

    /// <summary>
    /// The grids of the main list (contracts/ev-lists.md): the "Úteis" filter shows one grid of useful opponents;
    /// a search or "Todos" shows the useful ones first and the others after, each group only when it has items.
    /// </summary>
    private IEnumerable<Group> MainGroups(TrainingPokemon pokemon, bool searching, bool useful, HashSet<string> recent)
    {
        var totals = Store.SelectedTotals;
        if (!searching && useful)
        {
            yield return new Group(L["Evs.List.Useful"],
                [.. Store.Data.Opponents.Where(o => !recent.Contains(o.Name) && Evs.IsUseful(o, totals, pokemon.Targets)).Select(o => new SearchHit(o))]);
            yield break;
        }

        var items = searching
            ? Search.Find(_query, GameVersions.Parse(Store.Preferences.GameVersion))
            : [.. Store.Data.Opponents.Where(o => !recent.Contains(o.Name)).Select(o => new SearchHit(o))];
        var (usefulItems, others) = Evs.UsefulFirst(items, totals, pokemon.Targets);
        if (usefulItems.Count > 0)
        {
            yield return new Group(L["Evs.List.Useful"], usefulItems);
        }

        if (others.Count > 0 || usefulItems.Count == 0)
        {
            var title = usefulItems.Count == 0
                ? searching ? L["Evs.List.Results"] : L["Evs.List.All"]
                : searching ? L["Evs.List.OtherResults"] : L["Evs.List.Others"];
            yield return new Group(title, others);
        }
    }

    private void Record(string opponent)
    {
        if (Store.RecordBattle(opponent) is not { } record)
        {
            return;
        }

        var message = BattleToast.Message(L, Store, opponent, [record]);
        Toasts.Show(message, () => Store.UndoBattle(record));
    }
}
