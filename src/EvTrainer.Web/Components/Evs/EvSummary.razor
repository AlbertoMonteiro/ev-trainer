@inherits StoreAwareComponent

@if (Store.Selected is { } pokemon)
{
    var totals = Store.SelectedTotals;
    <section class="card summary">
        <div class="card-head">
            <h2 class="summary-who">
                <span role="img" aria-label="@L["Evs.Summary.Label", PokemonLabel(pokemon)]"><PokemonSprite Name="@pokemon.CurrentSpecies" Size="64" /></span>
            </h2>
            <span class="totals num muted">@L["Evs.Summary.Totals", totals.Sum()]</span>
            @if (!_editing)
            {
                <button type="button" class="edit-evs" @onclick="() => _editing = true">@L["Evs.Edit"]</button>
            }
        </div>
        <div class="summary-grid">
            @for (var i = 0; i < StatVector.Count; i++)
            {
                var current = totals[i];
                var target = pokemon.Targets[i];
                var state = current > target ? "over" : current == target && target > 0 ? "done" : "";
                var percent = target > 0 ? Math.Min(100, current * 100 / target) : 0;
                <div class="mini @state">
                    <div class="label">@StatShort(i)</div>
                    <div class="value">@current/@target</div>
                    <div class="bar"><span class="stat-@i" style="width: @(percent)%"></span></div>
                </div>
            }
        </div>
        @if (Store.Ordered.Count > 1)
        {
            var holderId = Store.ExpShareHolderId;
            <div class="exp-share-field">
                <label for="exp-share">@L["ExpShare.Label"]</label>
                <select id="exp-share" class="exp-share" @onchange="ChangeExpShare">
                    <option value="" selected="@(holderId is null)">@L["ExpShare.None"]</option>
                    @foreach (var (id, other) in Store.Ordered.Where(o => o.Id != Store.SelectedId || o.Id == holderId))
                    {
                        <option value="@id" selected="@(id == holderId)">@PokemonLabel(other)</option>
                    }
                </select>
            </div>
            @if (holderId is not null && holderId == Store.SelectedId)
            {
                <p class="exp-share-self hint">@L["ExpShare.Self"]</p>
            }
        }
        @if (_editing)
        {
            <EvEditor OnClose="() => _editing = false" />
        }
    </section>
}

@code {
    private bool _editing;

    private void ChangeExpShare(ChangeEventArgs e) =>
        Store.SetExpShare(e.Value?.ToString() is { Length: > 0 } id ? id : null);
}
