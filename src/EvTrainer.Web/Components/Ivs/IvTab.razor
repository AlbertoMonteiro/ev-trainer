@* IVs tab: table, known IVs and the level form, which can edit a row of the table in place. *@

<div class="iv-layout">
    <IvTable OnEdit="index => _editIndex = index" />
    <KnownIvsPanel />
    <LevelForm EditIndex="_editIndex" OnDone="() => _editIndex = null" />
</div>

@code {
    private int? _editIndex;
}
