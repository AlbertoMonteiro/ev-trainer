@inherits StoreAwareComponent
@inject ToastService Toasts

@if (Store.Selected is { } pokemon)
{
    var version = GameVersions.Parse(Store.Preferences.GameVersion);
    var rows = pokemon.IvLog.Select(entry => (Entry: entry, Cells: Ivs.RangeFor(entry, pokemon, Store.Data, version))).ToList();
    var final = Ivs.Final(pokemon, Store.Data, version);
    var nature = Store.Data.FindNature(pokemon.Nature);

    <section class="card">
        <div class="card-head">
            <h2>@L["Ivs.Title", PokemonLabel(pokemon)]</h2>
            <span class="muted">@(nature is null ? L["Ivs.NoNature"] : nature.Name)</span>
        </div>
        <div class="table-scroll">
            <table class="iv-table">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        @for (var i = 0; i < StatVector.Count; i++)
                        {
                            <th scope="col">@StatShort(i)</th>
                        }
                        <th scope="col"><span class="visually-hidden">@L["Ivs.Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="final">
                        <th scope="row">@L["Ivs.Row.Final"]</th>
                        @foreach (var cell in final)
                        {
                            @if (cell is FinalKnown(var known, var matches))
                            {
                                <td class="iv known @(matches ? "" : "bad")">
                                    <span class="value">@known</span>
                                    <span class="known-mark visually-hidden">@L["Ivs.Final.Known"]</span>
                                </td>
                            }
                            else
                            {
                                <td class="iv">@Show(cell)</td>
                            }
                        }
                        <td></td>
                    </tr>
                    @for (var r = 0; r < rows.Count; r++)
                    {
                        var index = r;
                        var (entry, cells) = rows[r];
                        <tr>
                            <th scope="row" title="@entry.Species">
                                @if (OnEdit.HasDelegate)
                                {
                                    @* The level label is the edit button: no extra column on a 360 px screen. *@
                                    <button type="button" class="edit" aria-label="@L["Ivs.EditLabel", entry.Level]"
                                            @onclick="() => OnEdit.InvokeAsync(index)">@L["Ivs.Row.Level", entry.Level]</button>
                                }
                                else
                                {
                                    @L["Ivs.Row.Level", entry.Level]
                                }
                            </th>
                            @foreach (var cell in cells)
                            {
                                <td class="iv @(cell is IvInconsistent ? "bad" : "")" title="@(cell is IvUnknowable ? L["Ivs.Cell.UnknowableHint"].Value : null)">@Show(cell)</td>
                            }
                            <td>
                                <button type="button" class="remove" aria-label="@L["Ivs.Remove", entry.Level]" @onclick="() => Remove(index, entry.Level)">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (OnEdit.HasDelegate && rows.Count > 0)
        {
            <p class="iv-note edit-hint hint">@L["Ivs.EditHint"]</p>
        }
        @if (final.Any(c => c is FinalKnown))
        {
            <p class="iv-note known-note hint">@L["Ivs.Final.KnownNote"]</p>
        }
        @if (MismatchedStats(final) is { Length: > 0 } mismatched)
        {
            <p class="iv-note known-mismatch warn">@L["Ivs.Final.KnownMismatch", mismatched]</p>
        }
        @if (rows.Any(r => r.Cells.Any(c => c is IvInconsistent)))
        {
            <p class="iv-note hint">@L["Ivs.InconsistentNote"]</p>
        }
    </section>
}

@code {
    /// <summary>Called with the row index when the player taps "Editar" on a level note.</summary>
    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    private string Show(IvCell cell) => cell switch
    {
        IvSpan(var min, var max) => min == max ? $"{min}" : $"{min}–{max}",
        IvInconsistent => L["Ivs.Cell.Inconsistent"],
        IvNoData => L["Ivs.Cell.NoData"],
        IvUnknowable => L["Ivs.Cell.Unknowable"],
    };

    private string Show(FinalCell cell) => cell switch
    {
        FinalSpan(var low, var high) => $"{low}–{high}",
        FinalSingle(var value) => $"{value}",
        FinalConflict => L["Ivs.Final.Conflict"],
        FinalNoData => L["Ivs.Final.NoData"],
        FinalKnown(var value, _) => $"{value}",
    };

    /// <summary>Short names of the stats whose known IV contradicts the notes, comma separated.</summary>
    private string MismatchedStats(FinalCell[] final) =>
        string.Join(", ", final.Select((cell, i) => (cell, i)).Where(x => x.cell is FinalKnown { MatchesNotes: false }).Select(x => StatShort(x.i)));

    private void Remove(int index, int level)
    {
        if (Store.RemoveLevel(index) is { } undo)
        {
            Toasts.Show(L["Ivs.Removed", level], undo);
        }
    }
}
